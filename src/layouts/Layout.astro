---
import '../styles/global.css';
import { SITE_META } from '../data/swrLanding';

interface Props {
	title?: string;
	description?: string;
}

const { title = SITE_META.title, description = SITE_META.description } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" sizes="512x512" href="/images/swararia-logo.png" />
		<link rel="apple-touch-icon" href="/images/swararia-logo.png" />
		<link
			rel="preload"
			href="/fonts/montserrat-latin-variable.woff2"
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/images/swararia-logo.png" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body>
		<slot />
		<nav class="swr-mobile-dock" aria-label="Navigasi cepat mobile">
			<a href="#top" class="swr-dock-link">On Air</a>
			<a href="#cerita" class="swr-dock-link">Alur 01–05</a>
			<a href="#fitur" class="swr-dock-link">Fitur</a>
			<a href="#download" class="swr-dock-link is-primary">Unduh</a>
		</nav>
		<dialog id="swr-lightbox" class="swr-lightbox" aria-labelledby="swr-lightbox-caption">
			<div class="swr-lightbox-card">
				<div class="swr-lightbox-head">
					<p id="swr-lightbox-caption" class="swr-lightbox-caption"></p>
					<button type="button" id="swr-lightbox-close" class="swr-lightbox-close" aria-label="Tutup tampilan gambar">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<line x1="18" y1="6" x2="6" y2="18" />
							<line x1="6" y1="6" x2="18" y2="18" />
						</svg>
					</button>
				</div>
				<img id="swr-lightbox-img" class="swr-lightbox-img" alt="" />
			</div>
		</dialog>
		<script is:inline src="/scripts/landing.js" defer></script>
	</body>
</html>
