---
import { SOUNDMAN_STORIES } from '../data/swrLanding';
---

<section id="cerita" class="swr-stories-section">
	<div class="swr-container">
		<div class="swr-stories-head">
			<h2 class="swr-stories-title">KATA TUKANG SOUND & SOUNDMAN</h2>
			<span class="swr-stories-note" aria-hidden="true">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
					<path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" />
				</svg>
			</span>
		</div>

		<div class="swr-stories-grid">
			{
				SOUNDMAN_STORIES.map((story) => (
					<article class="swr-story-card">
						<span class="swr-story-quote-mark" aria-hidden="true">&ldquo;</span>
						<p class="swr-story-text">{story.quote}</p>
						<div class="swr-story-author">
							<span class={`swr-story-avatar tone-${story.tone}`} aria-hidden="true">
								{story.badge}
							</span>
							<div>
								<div class="swr-story-name">{story.name}</div>
								<div class="swr-story-role">{story.role}</div>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.swr-stories-section {
		padding-top: 0;
		padding-bottom: var(--swr-section-gap);
	}

	.swr-stories-head {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 20px;
	}

	.swr-stories-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--swr-text-h2, clamp(1.75rem, 3.2vw, 2.25rem));
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--swr-navy);
	}

	.swr-stories-note {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--swr-cyan-soft);
		color: var(--swr-accent-text);
		font-weight: 900;
		font-size: 14px;
	}

	.swr-stories-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.swr-story-card {
		height: 100%;
		background: var(--swr-surface);
		border: 1px solid var(--swr-border);
		border-radius: var(--swr-radius-lg);
		padding: 22px 22px 20px;
		box-shadow: var(--swr-shadow-soft);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 16px;
	}

	.swr-story-quote-mark {
		display: block;
		font-family: var(--font-display);
		font-size: 36px;
		font-weight: 800;
		line-height: 0.8;
		color: var(--swr-cyan);
	}

	.swr-story-text {
		margin: 0;
		font-family: var(--font-sans);
		font-size: var(--swr-text-body, 0.95rem);
		font-weight: 400;
		line-height: 1.6;
		color: var(--swr-ink-muted);
	}

	.swr-story-author {
		display: flex;
		align-items: center;
		gap: 11px;
		padding-top: 8px;
		border-top: 1px solid var(--swr-border);
	}

	.swr-story-avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		font-weight: 900;
		color: var(--swr-navy);
		flex-shrink: 0;
	}

	.swr-story-avatar.tone-mint {
		background: var(--swr-mint-soft);
	}

	.swr-story-avatar.tone-cyan {
		background: var(--swr-cyan-soft);
	}

	.swr-story-avatar.tone-gold {
		background: var(--swr-gold-soft);
	}

	.swr-story-name {
		font-family: var(--font-display);
		font-size: var(--swr-text-body, 0.95rem);
		font-weight: 700;
		color: var(--swr-navy);
	}

	.swr-story-role {
		font-family: var(--font-sans);
		font-size: var(--swr-text-tag, 0.8rem);
		font-weight: 500;
		color: var(--swr-ink-muted);
	}

	@media (max-width: 900px) {
		.swr-stories-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.swr-stories-section {
			padding-bottom: 34px;
		}

		.swr-story-card {
			padding: 18px;
			gap: 12px;
		}

		.swr-story-quote-mark {
			font-size: 36px;
		}
	}
</style>
