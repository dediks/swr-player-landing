---
import { FOOTER_COPY } from '../data/swrLanding';
---

<footer class="swr-footer-section">
	<div class="swr-container">
		<div class="swr-footer-banner">
			<!-- Left Giant Display + Meta Items -->
			<div class="swr-footer-left">
				<h2 class="swr-footer-title">
					<span>{FOOTER_COPY.headlineLine1}</span>
					<span>{FOOTER_COPY.headlineLine2}</span>
				</h2>
				<div class="swr-script swr-footer-script">{FOOTER_COPY.scriptAccent}</div>

				<ul class="swr-footer-meta">
					{
						FOOTER_COPY.metaItems.map((meta) => (
							<li class="swr-footer-meta-item">
								<span class="swr-meta-dot" aria-hidden="true">
									{meta.icon === 'android' && (
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
											<line x1="12" y1="18" x2="12.01" y2="18" />
										</svg>
									)}
									{meta.icon === 'offline' && (
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
										</svg>
									)}
									{meta.icon === 'desktop' && (
										<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
											<line x1="8" y1="21" x2="16" y2="21" />
											<line x1="12" y1="17" x2="12" y2="21" />
										</svg>
									)}
								</span>
								<span>{meta.label}</span>
							</li>
						))
					}
				</ul>
			</div>

			<!-- Center Swararia Emblem Circle (mirroring the sun medallion in reference) -->
			<div class="swr-footer-medallion" aria-hidden="true">
				<div class="swr-medallion-ring">
					<img
						src="/images/swararia-logo.png"
						alt=""
						width="96"
						height="96"
						class="swr-medallion-logo"
					/>
				</div>
			</div>

			<!-- Right Contrasting Electric Cyan CTA Card -->
			<div class="swr-footer-cta-card">
				<h3 class="swr-footer-cta-title">{FOOTER_COPY.ctaTitle}</h3>
				<p class="swr-footer-cta-desc">{FOOTER_COPY.ctaDescription}</p>
				<button type="button" class="swr-btn swr-btn-navy swr-footer-btn" data-open-download="true">
					<span>{FOOTER_COPY.ctaButton}</span>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<line x1="5" y1="12" x2="19" y2="12" />
						<polyline points="12 5 19 12 12 19" />
					</svg>
				</button>
			</div>
		</div>

		<div class="swr-footer-bottom">
			<span>{FOOTER_COPY.copyright}</span>
			<a href="#top" class="swr-back-top">Kembali ke atas &uarr;</a>
		</div>
	</div>
</footer>

<style>
	.swr-footer-section {
		padding-bottom: 36px;
	}

	.swr-footer-banner {
		background: var(--swr-bg-soft);
		border: 1px solid var(--swr-border);
		border-radius: var(--swr-radius-xl);
		padding: 32px;
		display: grid;
		grid-template-columns: 1.2fr auto 0.95fr;
		align-items: center;
		gap: 24px;
		box-shadow: var(--swr-shadow-card);
	}

	.swr-footer-title {
		margin: 0;
		display: flex;
		flex-direction: column;
		font-family: var(--font-display);
		font-size: var(--swr-text-display, clamp(2.25rem, 5vw, 3.8rem));
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--swr-navy);
	}

	.swr-footer-script {
		font-family: var(--font-script);
		font-size: var(--swr-text-display-sub, clamp(1.85rem, 4vw, 2.8rem));
		font-weight: 400;
		margin-top: 4px;
		margin-bottom: 20px;
	}

	.swr-footer-meta {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.swr-footer-meta-item {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 11.5px;
		font-weight: 700;
		color: var(--swr-navy);
		background: var(--swr-surface);
		border: 1px solid var(--swr-border);
		border-radius: 999px;
		padding: 5px 12px 5px 5px;
	}

	.swr-meta-dot {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		background: var(--swr-surface);
		color: var(--swr-accent-text);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 3px 8px rgba(6, 34, 75, 0.08);
	}

	/* Center Medallion */
	.swr-footer-medallion {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.swr-medallion-ring {
		width: 132px;
		height: 132px;
		border-radius: 50%;
		background: #06224b;
		border: 4px solid var(--swr-surface);
		outline: 3px dashed rgba(0, 168, 243, 0.45);
		outline-offset: 6px;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 14px 28px rgba(6, 34, 75, 0.25);
	}

	.swr-medallion-logo {
		width: 102px;
		height: 102px;
		border-radius: 50%;
	}

	/* Right CTA Card */
	.swr-footer-cta-card {
		background: linear-gradient(145deg, var(--swr-cyan), var(--swr-cyan-dark));
		border-radius: var(--swr-radius-lg);
		padding: 24px;
		color: #ffffff;
		box-shadow: var(--swr-shadow-cyan);
	}

	.swr-footer-cta-title {
		margin: 0 0 8px;
		font-family: var(--font-display);
		font-size: var(--swr-text-h3, 1.3rem);
		font-weight: 800;
		letter-spacing: -0.02em;
	}

	.swr-footer-cta-desc {
		margin: 0 0 18px;
		font-family: var(--font-sans);
		font-size: var(--swr-text-body-sm, 0.875rem);
		font-weight: 400;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.92);
	}

	.swr-footer-btn {
		width: 100%;
		justify-content: space-between;
	}

	.swr-footer-bottom {
		margin-top: 18px;
		padding-inline: 8px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px;
		font-size: 12px;
		font-weight: 600;
		color: var(--swr-ink-muted);
	}

	.swr-back-top {
		font-weight: 800;
		color: var(--swr-navy);
	}

	.swr-back-top:hover {
		color: var(--swr-accent-text);
	}

	@media (max-width: 960px) {
		.swr-footer-banner {
			grid-template-columns: 1fr;
			text-align: left;
			padding: 24px 20px;
		}

		.swr-footer-medallion {
			justify-content: flex-start;
		}
	}

	@media (max-width: 640px) {
		.swr-footer-banner {
			padding: 22px 16px;
			gap: 18px;
			border-radius: 26px;
		}

		.swr-footer-title {
			font-size: clamp(1.95rem, 9vw, 2.5rem);
		}

		.swr-footer-script {
			margin-bottom: 14px;
		}

		.swr-footer-meta {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 8px;
		}

		.swr-footer-medallion {
			justify-content: center;
			padding-block: 4px;
		}

		.swr-medallion-ring {
			width: 104px;
			height: 104px;
		}

		.swr-medallion-logo {
			width: 80px;
			height: 80px;
		}

		.swr-footer-cta-card {
			padding: 20px 18px;
		}

		.swr-footer-bottom {
			justify-content: center;
			text-align: center;
		}
	}
</style>
