---
import { DOWNLOAD_PACKAGES, MODULES_SHOWCASE, RELEASE_NOTES_SUMMARY } from '../data/swrLanding';

const androidPackages = DOWNLOAD_PACKAGES.filter((pkg) => pkg.platform === 'android');
const windowsPackages = DOWNLOAD_PACKAGES.filter((pkg) => pkg.platform === 'windows');
---

<!-- Module Detail Dialog -->
<dialog id="swrModuleDialog" class="swr-dialog" aria-labelledby="swrModuleDialogTitle">
	<div class="swr-dialog-box">
		<div class="swr-dialog-head">
			<span id="swrModuleDialogTitle" class="swr-dialog-kicker">DETAIL MODUL SWR PLAYER</span>
			<button type="button" class="swr-dialog-close" data-close-dialog="swrModuleDialog" aria-label="Tutup dialog">
				&times;
			</button>
		</div>

		{
			MODULES_SHOWCASE.items.map((mod) => (
				<div class="swr-modal-panel" data-module-panel={mod.id} hidden>
					<div class="swr-modal-badge">{mod.numberLabel}</div>
					<h3 class="swr-modal-title">{mod.title} &mdash; {mod.subtitle}</h3>
					<p class="swr-modal-summary">{mod.summary}</p>
					<ul class="swr-modal-list">
						{mod.highlights.map((point) => <li>{point}</li>)}
					</ul>
					<div class="swr-modal-tip">{mod.stageTip}</div>
				</div>
			))
		}

		<div class="swr-dialog-foot">
			<button type="button" class="swr-btn swr-btn-cyan" data-open-download="true" data-close-parent="swrModuleDialog">
				<span>UNDUH ANDROID / WINDOWS</span>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="5" y1="12" x2="19" y2="12" />
					<polyline points="12 5 19 12 12 19" />
				</svg>
			</button>
		</div>
	</div>
</dialog>

<!-- Dual-Platform Download Dialog -->
<dialog id="swrDownloadDialog" class="swr-dialog" aria-labelledby="swrDownloadDialogTitle">
	<div class="swr-dialog-box">
		<div class="swr-dialog-head">
			<span id="swrDownloadDialogTitle" class="swr-dialog-kicker">UNDUH SWR PLAYER (ANDROID &amp; WINDOWS)</span>
			<button type="button" class="swr-dialog-close" data-close-dialog="swrDownloadDialog" aria-label="Tutup dialog">
				&times;
			</button>
		</div>

		<h3 class="swr-modal-title">Pilih Perangkat Anda</h3>
		<p class="swr-modal-summary">
			Pasang <strong>Android (.apk)</strong> di HP untuk meja mixer, atau <strong>Desktop Windows (.exe)</strong> untuk rapikan lagu dan memutar dari laptop.
		</p>

		<div class="swr-dl-tabs" role="tablist" aria-label="Pilih platform unduhan">
			<button
				type="button"
				class="swr-dl-tab active"
				role="tab"
				aria-selected="true"
				data-dl-tab="android"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:6px;">
					<rect x="5" y="2" width="14" height="20" rx="2" ry="2" />
					<line x1="12" y1="18" x2="12.01" y2="18" />
				</svg>
				<span>Android (.apk)</span>
			</button>
			<button
				type="button"
				class="swr-dl-tab"
				role="tab"
				aria-selected="false"
				data-dl-tab="windows"
			>
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right:6px;">
					<rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
					<line x1="8" y1="21" x2="16" y2="21" />
					<line x1="12" y1="17" x2="12" y2="21" />
				</svg>
				<span>Desktop Windows (.exe)</span>
			</button>
		</div>

		<div class="swr-apk-list" data-dl-panel="android">
			{
				androidPackages.map((pkg) => (
					<div class={pkg.recommended ? 'swr-apk-card recommended' : 'swr-apk-card'}>
						<div class="swr-apk-top">
							<div>
								<div class="swr-apk-arch">{pkg.archLabel}</div>
								<div class="swr-apk-title">{pkg.title}</div>
							</div>
							<span class="swr-apk-size">{pkg.approxSize}</span>
						</div>
						<p class="swr-apk-compat">{pkg.compatibility}</p>
						<button
							type="button"
							class={pkg.recommended ? 'swr-btn swr-btn-cyan swr-apk-btn' : 'swr-btn swr-btn-navy swr-apk-btn'}
							data-apk-select={pkg.fileName}
							data-apk-url={pkg.downloadUrl}
						>
							<span>UNDUH {pkg.fileName}</span>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="12" y1="5" x2="12" y2="19" />
								<polyline points="19 12 12 19 5 12" />
							</svg>
						</button>
					</div>
				))
			}
		</div>

		<div class="swr-apk-list" data-dl-panel="windows" hidden>
			{
				windowsPackages.map((pkg) => (
					<div class={pkg.recommended ? 'swr-apk-card recommended' : 'swr-apk-card'}>
						<div class="swr-apk-top">
							<div>
								<div class="swr-apk-arch">{pkg.archLabel}</div>
								<div class="swr-apk-title">{pkg.title}</div>
							</div>
							<span class="swr-apk-size">{pkg.approxSize}</span>
						</div>
						<p class="swr-apk-compat">{pkg.compatibility}</p>
						<button
							type="button"
							class="swr-btn swr-btn-cyan swr-apk-btn"
							data-apk-select={pkg.fileName}
							data-apk-url={pkg.downloadUrl}
						>
							<span>UNDUH {pkg.fileName}</span>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="12" y1="5" x2="12" y2="19" />
								<polyline points="19 12 12 19 5 12" />
							</svg>
						</button>
					</div>
				))
			}
		</div>

		<div id="swrApkStatusNote" class="swr-apk-notice" hidden role="status" aria-live="polite"></div>

		<div class="swr-release-box">
			<div class="swr-release-head">Catatan Penting Instalasi &amp; Update:</div>
			<ul class="swr-modal-list compact">
				{RELEASE_NOTES_SUMMARY.map((note) => <li>{note}</li>)}
			</ul>
		</div>
	</div>
</dialog>

<script is:inline src="/scripts/modals.js" defer></script>

<style>
	.swr-dialog {
		border: 1px solid var(--swr-border);
		padding: 0;
		border-radius: 26px;
		max-width: 560px;
		width: calc(100% - 28px);
		max-height: calc(100dvh - 28px);
		overflow-y: auto;
		background: var(--swr-surface);
		color: var(--swr-navy);
		box-shadow: 0 28px 64px rgba(4, 21, 48, 0.45);
	}

	.swr-dialog::backdrop {
		background: rgba(4, 21, 48, 0.68);
		backdrop-filter: blur(4px);
	}

	.swr-dialog-box {
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.swr-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.swr-dialog-kicker {
		font-size: 11px;
		font-weight: 900;
		letter-spacing: 0.08em;
		color: var(--swr-accent-text);
	}

	.swr-dialog-close {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--swr-border-strong);
		background: var(--swr-bg-canvas);
		color: var(--swr-navy);
		font-size: 20px;
		font-weight: 800;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		line-height: 1;
	}

	.swr-modal-badge {
		display: inline-block;
		background: var(--swr-cyan-soft);
		color: var(--swr-navy);
		font-size: 10.5px;
		font-weight: 800;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 8px;
	}

	.swr-modal-title {
		margin: 0 0 6px;
		font-family: var(--font-display);
		font-size: var(--swr-text-h3, 1.35rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--swr-navy);
	}

	.swr-modal-summary {
		margin: 0 0 8px;
		font-family: var(--font-sans);
		font-size: var(--swr-text-body, 0.95rem);
		font-weight: 400;
		line-height: 1.6;
		color: var(--swr-ink-muted);
	}

	.swr-dl-tabs {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 8px;
		background: var(--swr-bg-canvas);
		border: 1px solid var(--swr-border);
		border-radius: 14px;
		padding: 5px;
	}

	.swr-dl-tab {
		border: none;
		border-radius: 10px;
		padding: 10px 12px;
		font-family: var(--font-sans);
		font-size: var(--swr-text-btn, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		background: transparent;
		color: var(--swr-ink-muted);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: background-color 150ms ease, color 150ms ease;
	}

	.swr-dl-tab.active {
		background: linear-gradient(135deg, var(--swr-cyan), var(--swr-cyan-dark));
		color: #ffffff;
	}

	.swr-modal-list {
		margin: 0 0 12px;
		padding-left: 18px;
		font-size: var(--swr-text-body-sm, 0.875rem);
		color: var(--swr-navy);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.swr-modal-list.compact {
		margin-bottom: 0;
		font-size: 12px;
		color: var(--swr-ink-muted);
	}

	.swr-modal-tip {
		background: var(--swr-mint-soft);
		border: 1px solid rgba(59, 212, 164, 0.45);
		border-radius: 12px;
		padding: 10px 12px;
		font-size: var(--swr-text-btn, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--swr-navy);
	}

	.swr-dialog-foot {
		padding-top: 6px;
	}

	.swr-apk-list {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.swr-apk-list[hidden] {
		display: none;
	}

	.swr-apk-card {
		background: var(--swr-bg-canvas);
		border: 1.5px solid var(--swr-border);
		border-radius: 16px;
		padding: 14px;
	}

	.swr-apk-card.recommended {
		background: var(--swr-bg-soft);
		border-color: var(--swr-cyan);
	}

	.swr-apk-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 8px;
		margin-bottom: 4px;
	}

	.swr-apk-arch {
		font-size: 11px;
		font-weight: 900;
		letter-spacing: 0.06em;
		color: var(--swr-accent-text);
	}

	.swr-apk-title {
		font-size: 14.5px;
		font-weight: 800;
		color: var(--swr-navy);
	}

	.swr-apk-size {
		background: var(--swr-surface);
		border: 1px solid var(--swr-border-strong);
		border-radius: 999px;
		padding: 3px 9px;
		font-size: 11px;
		font-weight: 800;
		color: var(--swr-navy);
		flex-shrink: 0;
	}

	.swr-apk-compat {
		margin: 0 0 10px;
		font-size: 12px;
		color: var(--swr-ink-muted);
	}

	.swr-apk-btn {
		width: 100%;
		padding: 11px 16px;
		font-size: 12px;
	}

	.swr-apk-notice {
		background: var(--swr-gold-soft);
		border: 1px solid var(--swr-gold);
		border-radius: 12px;
		padding: 10px 12px;
		font-size: var(--swr-text-btn, 0.9rem);
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--swr-navy);
	}

	.swr-release-box {
		background: var(--swr-bg-canvas);
		border-radius: 14px;
		padding: 12px 14px;
	}

	.swr-release-head {
		font-size: 12px;
		font-weight: 800;
		color: var(--swr-navy);
		margin-bottom: 6px;
	}

	@media (max-width: 540px) {
		.swr-dialog {
			border-radius: 22px;
			width: calc(100% - 20px);
			max-height: calc(100dvh - 20px);
		}

		.swr-dialog-box {
			padding: 18px 16px;
			gap: 12px;
		}

		.swr-dl-tabs {
			grid-template-columns: 1fr;
		}

		.swr-dialog-foot .swr-btn {
			width: 100%;
		}
	}
</style>
