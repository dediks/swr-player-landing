---
import type { ShowcasePaneImage } from '../data/swrLanding';

interface Props {
	screens: ShowcasePaneImage[];
	layout: 'desktop-android' | 'trio';
	eager?: boolean;
}

const { screens, layout, eager = false } = Astro.props;
---

<div class={layout === 'trio' ? 'swr-screens is-trio' : 'swr-screens'}>
	{
		screens.map((screen) => {
			const isDesktop = screen.kind === 'desktop';
			const cardClass = [
				'swr-shot-card',
				isDesktop ? 'is-desktop' : 'is-android',
				layout === 'desktop-android' && !isDesktop ? 'is-android-solo' : '',
			]
				.filter(Boolean)
				.join(' ');

			return (
				<figure class={cardClass}>
					<figcaption class="swr-shot-bar">
						{isDesktop && (
							<span class="swr-shot-dots" aria-hidden="true">
								<span></span>
								<span></span>
								<span></span>
							</span>
						)}
						<span class="swr-shot-label">{screen.label}</span>
						<span class="swr-shot-zoom-hint" aria-hidden="true">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="11" cy="11" r="8" />
								<line x1="21" y1="21" x2="16.65" y2="16.65" />
								<line x1="11" y1="8" x2="11" y2="14" />
								<line x1="8" y1="11" x2="14" y2="11" />
							</svg>
						</span>
					</figcaption>
					<button
						type="button"
						class={isDesktop ? 'swr-shot-trigger swr-shot-frame' : 'swr-shot-trigger swr-android-frame'}
						data-zoom-src={screen.src}
						data-zoom-alt={screen.alt}
						data-zoom-label={screen.label}
						aria-label={`Perbesar gambar ${screen.label}`}
					>
						<img
							src={screen.src}
							alt={screen.alt}
							width={screen.width}
							height={screen.height}
							loading={eager ? 'eager' : 'lazy'}
							class={isDesktop ? 'swr-desktop-img' : 'swr-android-img'}
						/>
					</button>
				</figure>
			);
		})
	}
</div>

<style>
	.swr-screens {
		display: grid;
		grid-template-columns: minmax(0, 3.2fr) minmax(220px, 1fr);
		gap: 16px;
		align-items: stretch;
	}

	.swr-screens.is-trio {
		grid-template-columns: minmax(0, 2.5fr) minmax(170px, 0.85fr) minmax(170px, 0.85fr);
	}

	.swr-shot-card {
		margin: 0;
		background-color: var(--swr-surface);
		border: 1px solid var(--swr-border);
		border-radius: var(--swr-radius-lg);
		padding: 10px;
		display: flex;
		flex-direction: column;
	}

	.swr-shot-bar {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 4px 8px;
	}

	.swr-shot-dots {
		display: inline-flex;
		gap: 4px;
		flex-shrink: 0;
	}

	.swr-shot-dots span {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background-color: #cbd5e1;
	}

	.swr-shot-label {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--swr-ink-muted);
		line-height: 1.35;
	}

	.swr-shot-zoom-hint {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		border-radius: var(--swr-radius-sm);
		background-color: var(--swr-surface-alt);
		border: 1px solid var(--swr-border);
		color: var(--swr-ink-2);
		flex-shrink: 0;
	}

	.swr-shot-trigger {
		width: 100%;
		padding: 0;
		cursor: zoom-in;
		transition: border-color 140ms ease;
	}

	.swr-shot-trigger:hover {
		border-color: var(--swr-accent);
	}

	.swr-shot-frame,
	.swr-android-frame {
		flex: 1;
		border: 1px solid var(--swr-border);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.swr-shot-frame {
		border-radius: var(--swr-radius-sm);
		background-color: #0d1117;
	}

	.swr-android-frame {
		border-radius: var(--swr-radius-md);
		background-color: #0b131d;
	}

	.swr-desktop-img,
	.swr-android-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	@media (max-width: 900px) {
		.swr-screens {
			grid-template-columns: 1fr;
			gap: 12px;
		}

		.swr-shot-card.is-android-solo {
			max-width: 220px;
			width: 100%;
			margin-inline: auto;
		}

		.swr-screens.is-trio {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 10px;
		}

		.swr-screens.is-trio .swr-shot-card.is-desktop {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 520px) {
		.swr-shot-card {
			padding: 8px;
			border-radius: 10px;
		}

		.swr-shot-bar {
			padding: 2px 2px 6px;
		}

		.swr-shot-label {
			font-size: 0.68rem;
		}
	}
</style>
