---
import { NAV_LINKS, SITE_META } from '../data/swrLanding';
---

<header class="swr-nav-wrap">
	<div class="swr-container swr-nav">
		<a href="#top" class="swr-brand" aria-label="SWR Player by Swararia">
			<img
				src="/images/swararia-logo.png"
				alt="Logo Swararia"
				width="34"
				height="34"
				class="swr-brand-logo"
			/>
			<span class="swr-brand-text">
				<span class="swr-brand-main">{SITE_META.brandName}</span>
				<span class="swr-brand-sub">{SITE_META.brandSub}</span>
			</span>
		</a>

		<nav class="swr-nav-links" aria-label="Navigasi utama">
			{
				NAV_LINKS.map((item) => (
					<a href={item.href} class="swr-nav-link">
						{item.label}
					</a>
				))
			}
			<a href="#download" class="swr-btn swr-btn-primary swr-nav-cta">
				Download
			</a>
		</nav>
	</div>
</header>

<style>
	.swr-nav-wrap {
		position: sticky;
		top: 0;
		z-index: 40;
		background-color: var(--swr-surface);
		border-bottom: 1px solid var(--swr-border);
	}

	.swr-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 10px;
		padding-bottom: 10px;
	}

	.swr-brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		flex-shrink: 0;
	}

	.swr-brand-logo {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--swr-border);
	}

	.swr-brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.08;
	}

	.swr-brand-main {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 0.98rem;
		letter-spacing: -0.01em;
		color: var(--swr-ink);
	}

	.swr-brand-sub {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 0.64rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--swr-ink-muted);
	}

	.swr-nav-links {
		display: flex;
		align-items: center;
		gap: 22px;
	}

	.swr-nav-link {
		font-family: var(--font-ui);
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--swr-ink-2);
		transition: color 140ms ease;
	}

	.swr-nav-link:hover {
		color: var(--swr-accent);
	}

	.swr-nav-cta {
		min-height: 40px;
		padding: 8px 16px;
		font-size: 0.84rem;
	}

	@media (max-width: 720px) {
		.swr-nav {
			padding-top: 8px;
			padding-bottom: 8px;
		}

		.swr-nav-links {
			gap: 12px;
		}

		.swr-nav-link {
			display: none;
		}
	}
</style>
