---
import ScreenshotGrid from './ScreenshotGrid.astro';
import { STORY_SECTION } from '../data/swrLanding';
---

<section id="cerita" class="swr-story">
	<div class="swr-container">
		<div class="swr-section-head">
			<span class="swr-kicker">{STORY_SECTION.eyebrow}</span>
			<h2 class="swr-section-title">{STORY_SECTION.heading}</h2>
			<p class="swr-section-sub">{STORY_SECTION.subheading}</p>
		</div>

		<nav class="swr-story-map" aria-label="Urutan alur kerja SWR Player">
			{
				STORY_SECTION.chapters.map((chapter) => (
					<a href={`#${chapter.id}`} class="swr-step-pill">
						<span class="swr-step-num">{chapter.step}</span>
						<span class="swr-step-name">{chapter.shortLabel}</span>
					</a>
				))
			}
		</nav>

		<div class="swr-story-list">
			{
				STORY_SECTION.chapters.map((chapter) => (
					<article id={chapter.id} class="swr-story-card">
						<div class="swr-story-top">
							<div class="swr-story-copy">
								<span class="swr-story-phase">{chapter.phase}</span>
								<h3 class="swr-story-title">{chapter.title}</h3>
								<p class="swr-story-problem">{chapter.problem}</p>
								<p class="swr-story-solution">{chapter.solution}</p>
							</div>

							<div class="swr-highlights swr-story-highlights">
								{
									chapter.highlights.map((item) => (
										<div class="swr-highlight-item">
											<h4 class="swr-highlight-device">{item.device}</h4>
											<p class="swr-highlight-detail">{item.detail}</p>
										</div>
									))
								}
							</div>
						</div>

						<div class="swr-story-visual">
							<ScreenshotGrid screens={chapter.screens} layout={chapter.layout} />
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.swr-story {
		background-color: var(--swr-canvas);
		border-bottom: 1px solid var(--swr-border);
		padding: 52px 0 60px;
	}

	.swr-story-map {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 8px;
		margin-bottom: 24px;
	}

	.swr-step-pill {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		background-color: var(--swr-surface);
		border: 1px solid var(--swr-border-strong);
		border-radius: var(--swr-radius-md);
		padding: 6px 13px 6px 8px;
		transition: border-color 140ms ease, background-color 140ms ease;
	}

	.swr-step-pill:hover {
		border-color: var(--swr-accent);
		background-color: var(--swr-accent-soft);
	}

	.swr-step-num {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 26px;
		height: 24px;
		padding: 0 5px;
		border-radius: 4px;
		background-color: var(--swr-surface-alt);
		border: 1px solid var(--swr-border);
		color: var(--swr-accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.swr-step-name {
		font-family: var(--font-ui);
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--swr-ink);
		white-space: nowrap;
	}

	.swr-story-list {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.swr-story-card {
		background-color: var(--swr-surface);
		border: 1px solid var(--swr-border);
		border-radius: var(--swr-radius-lg);
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.swr-story-top {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 20px;
		align-items: start;
	}

	.swr-story-phase {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--swr-accent);
		margin-bottom: 6px;
	}

	.swr-story-title {
		font-size: clamp(1.14rem, 1.9vw, 1.38rem);
		font-weight: 700;
		line-height: 1.26;
		margin: 0 0 10px;
	}

	.swr-story-problem {
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--swr-ink);
		background-color: var(--swr-surface-alt);
		border-left: 3px solid var(--swr-accent);
		padding: 8px 12px;
		border-radius: 0 var(--swr-radius-sm) var(--swr-radius-sm) 0;
		line-height: 1.54;
		margin: 0 0 10px;
	}

	.swr-story-solution {
		font-size: 0.89rem;
		color: var(--swr-ink-2);
		line-height: 1.6;
		margin: 0;
	}

	@media (max-width: 900px) {
		.swr-story {
			padding: 36px 0 44px;
		}

		.swr-story-top {
			grid-template-columns: 1fr;
			gap: 14px;
		}
	}

	@media (max-width: 720px) {
		.swr-story-map {
			flex-wrap: nowrap;
			overflow-x: auto;
			scroll-snap-type: x proximity;
			scrollbar-width: none;
			gap: 8px;
			margin-inline: -16px;
			padding: 2px 16px 8px;
			margin-bottom: 16px;
		}

		.swr-story-map::-webkit-scrollbar {
			display: none;
		}

		.swr-step-pill {
			flex-shrink: 0;
			scroll-snap-align: start;
			padding: 6px 12px 6px 8px;
		}

		.swr-step-name {
			font-size: 0.78rem;
		}

		.swr-story-top {
			display: contents;
		}

		.swr-story-copy {
			order: 0;
		}

		.swr-story-visual {
			order: 1;
		}

		.swr-story-highlights {
			order: 2;
		}
	}

	@media (max-width: 640px) {
		.swr-story {
			padding: 28px 0 36px;
		}

		.swr-story-list {
			gap: 16px;
		}

		.swr-story-card {
			padding: 15px;
			border-radius: 10px;
			gap: 14px;
		}

		.swr-story-title {
			font-size: 1.08rem;
		}

		.swr-story-problem,
		.swr-story-solution {
			font-size: 0.85rem;
			line-height: 1.52;
		}
	}
</style>
