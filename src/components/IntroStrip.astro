---
import { INTRO_COPY } from '../data/swrLanding';
---

<section id="kenalan" class="swr-intro-section">
	<div class="swr-container">
		<div class="swr-intro-card">
			<!-- Col 1: Visual Flow Card (Persiapan -> Di Meja Mixer) -->
			<div class="swr-intro-visual">
				<div class="swr-mixer-box">
					<div class="swr-mixer-top">
						<span class="swr-mixer-dot"></span>
						<span>ALUR KERJA DI LAPANGAN</span>
					</div>
					<div class="swr-mixer-route">
						<strong>{INTRO_COPY.deviceStatusLabel}</strong>
						<span class="swr-mixer-badge">{INTRO_COPY.deviceStatusBadge}</span>
					</div>
					<div class="swr-flow-diagram" aria-hidden="true">
						<div class="swr-flow-node">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="4" width="18" height="12" rx="2" />
								<path d="M2 19h20" stroke-linecap="round" />
							</svg>
							<span>Laptop</span>
							<small>Cek Palsu &amp; Rata</small>
						</div>
						<svg class="swr-flow-arrow" viewBox="0 0 20 12" fill="none">
							<path d="M1 6h16M13 2l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<div class="swr-flow-node accent">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="7" y="2" width="10" height="20" rx="2" />
								<path d="M11 18h2" stroke-linecap="round" />
							</svg>
							<span>HP / PC</span>
							<small>Aman + Fade</small>
						</div>
						<svg class="swr-flow-arrow" viewBox="0 0 20 12" fill="none">
							<path d="M1 6h16M13 2l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<div class="swr-flow-node">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3" stroke-linecap="round" />
								<circle cx="4" cy="12" r="2" />
								<circle cx="12" cy="10" r="2" />
								<circle cx="20" cy="14" r="2" />
							</svg>
							<span>Mixer</span>
							<small>Suara Tenang</small>
						</div>
					</div>
					<div class="swr-mixer-foot">{INTRO_COPY.deviceSecondaryBadge}</div>
				</div>
			</div>

			<!-- Col 2: Two-tone Narrative -->
			<div class="swr-intro-copy">
				<h2 class="swr-intro-heading">
					<span class="swr-intro-eyebrow">{INTRO_COPY.eyebrow}</span>
					<span>{INTRO_COPY.headline}</span>
				</h2>
				<p class="swr-intro-paragraph">{INTRO_COPY.paragraph}</p>
				<div class="swr-intro-sign swr-script">{INTRO_COPY.signature}</div>
			</div>

			<!-- Col 3: Divider + 5 Icon Capability List -->
			<div class="swr-intro-list-wrap">
				<ul class="swr-intro-list">
					{
						INTRO_COPY.highlights.map((item) => (
							<li class="swr-intro-item">
								<span class="swr-intro-icon" aria-hidden="true">
									{item.icon === 'shield' && (
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
										</svg>
									)}
									{item.icon === 'cue' && (
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<circle cx="12" cy="12" r="10" />
											<circle cx="12" cy="12" r="6" />
											<circle cx="12" cy="12" r="2" />
										</svg>
									)}
									{item.icon === 'fader' && (
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<line x1="4" y1="21" x2="4" y2="14" />
											<line x1="4" y1="10" x2="4" y2="3" />
											<line x1="12" y1="21" x2="12" y2="12" />
											<line x1="12" y1="8" x2="12" y2="3" />
											<line x1="20" y1="21" x2="20" y2="16" />
											<line x1="20" y1="12" x2="20" y2="3" />
											<line x1="1" y1="14" x2="7" y2="14" />
											<line x1="9" y1="8" x2="15" y2="8" />
											<line x1="17" y1="16" x2="23" y2="16" />
										</svg>
									)}
									{item.icon === 'pads' && (
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<rect x="3" y="3" width="7" height="7" />
											<rect x="14" y="3" width="7" height="7" />
											<rect x="14" y="14" width="7" height="7" />
											<rect x="3" y="14" width="7" height="7" />
										</svg>
									)}
									{item.icon === 'remote' && (
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M5 12.55a11 11 0 0 1 14.08 0" />
											<path d="M1.42 9a16 16 0 0 1 21.16 0" />
											<path d="M8.53 16.11a6 6 0 0 1 6.95 0" />
											<line x1="12" y1="20" x2="12.01" y2="20" />
										</svg>
									)}
								</span>
								<span class="swr-intro-item-label">{item.label}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.swr-intro-section {
		position: relative;
		z-index: 5;
		margin-top: -30px;
		padding-bottom: var(--swr-section-gap);
	}

	.swr-intro-card {
		background: var(--swr-surface);
		border: 1px solid var(--swr-border);
		border-radius: var(--swr-radius-xl);
		box-shadow: var(--swr-shadow-card);
		padding: 28px;
		display: grid;
		grid-template-columns: 0.92fr 1.12fr 1fr;
		gap: 28px;
		align-items: stretch;
	}

	.swr-intro-copy,
	.swr-intro-list-wrap {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.swr-intro-visual {
		height: 100%;
		display: flex;
	}

	.swr-mixer-box {
		width: 100%;
		background: linear-gradient(155deg, var(--swr-console-bg), #152520);
		border: 1px solid var(--swr-console-border);
		border-radius: var(--swr-radius-lg);
		padding: 20px;
		color: var(--swr-console-text);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 14px;
	}

	.swr-mixer-top {
		display: flex;
		align-items: center;
		gap: 7px;
		font-size: 10.5px;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--swr-console-safe);
	}

	.swr-mixer-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--swr-console-safe);
	}

	.swr-mixer-route {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.swr-mixer-route strong {
		font-size: 15px;
		color: #ffffff;
	}

	.swr-mixer-badge {
		align-self: flex-start;
		background: #132b21;
		border: 1px solid #285944;
		color: var(--swr-console-safe);
		font-size: 11px;
		font-weight: 700;
		padding: 4px 10px;
		border-radius: 999px;
	}

	.swr-flow-diagram {
		display: grid;
		grid-template-columns: 1fr auto 1fr auto 1fr;
		align-items: center;
		gap: 5px;
		background: var(--swr-console-deep);
		border: 1px solid var(--swr-console-border);
		border-radius: 14px;
		padding: 10px 8px;
	}

	.swr-flow-node {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 3px;
		color: var(--swr-console-text);
	}

	.swr-flow-node svg {
		width: 20px;
		height: 20px;
		color: var(--swr-console-bt);
	}

	.swr-flow-node.accent svg {
		color: var(--swr-console-safe);
	}

	.swr-flow-node span {
		font-size: 10px;
		font-weight: 800;
		line-height: 1.1;
	}

	.swr-flow-node small {
		font-size: 8.5px;
		line-height: 1.15;
		color: var(--swr-console-muted);
	}

	.swr-flow-arrow {
		width: 14px;
		height: 10px;
		color: var(--swr-console-safe);
		flex-shrink: 0;
	}

	.swr-mixer-foot {
		font-size: 11px;
		font-weight: 600;
		color: var(--swr-console-warn);
	}

	.swr-intro-heading {
		margin: 0 0 12px;
		display: flex;
		flex-direction: column;
		gap: 3px;
		font-family: var(--font-display);
		font-size: var(--swr-text-h2, clamp(1.75rem, 3.2vw, 2.25rem));
		font-weight: 800;
		line-height: 1.16;
		letter-spacing: -0.02em;
		color: var(--swr-navy);
	}

	.swr-intro-eyebrow {
		color: var(--swr-accent-text);
		font-size: var(--swr-text-tag, 0.75rem);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		margin-bottom: 4px;
	}

	.swr-intro-paragraph {
		margin: 0 0 14px;
		font-family: var(--font-sans);
		font-size: var(--swr-text-body, 0.95rem);
		font-weight: 400;
		line-height: 1.68;
		color: var(--swr-ink-muted);
	}

	.swr-intro-sign {
		font-family: var(--font-script);
		font-size: 26px;
		font-weight: 400;
		color: var(--swr-navy);
		transform: rotate(-2deg);
	}

	.swr-intro-list-wrap {
		border-left: 1.5px solid var(--swr-border);
		padding-left: 24px;
	}

	.swr-intro-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 13px;
	}

	.swr-intro-item {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.swr-intro-icon {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		background: var(--swr-cyan-soft);
		color: var(--swr-accent-text);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.swr-intro-item-label {
		font-family: var(--font-sans);
		font-size: var(--swr-text-body, 0.95rem);
		font-weight: 600;
		color: var(--swr-navy);
		line-height: 1.35;
	}

	@media (max-width: 960px) {
		.swr-intro-section {
			margin-top: 12px;
		}

		.swr-intro-card {
			grid-template-columns: 1fr;
			padding: 20px;
		}

		.swr-intro-list-wrap {
			border-left: none;
			border-top: 1.5px solid var(--swr-border);
			padding-left: 0;
			padding-top: 18px;
		}
	}

	@media (max-width: 640px) {
		.swr-intro-section {
			padding-bottom: 28px;
		}

		.swr-intro-card {
			padding: 18px 16px;
			gap: 18px;
			border-radius: 26px;
		}

		.swr-intro-item {
			gap: 10px;
		}
	}
</style>
